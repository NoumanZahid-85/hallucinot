# Any TypeSafe-compatible System One endpoint works. Pick ONE setup:

# 1) OpenJev on codiv.ai (free: 100M input tokens, no card). Keys look like sk-codiv-...
TYPESAFE_BASE_URL=https://api.codiv.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# 2) Real Jev from TypeSafe (paid, $0.042 per 1M input tokens)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest

# 3) Real Jev through Vercel AI Gateway ($5/month free credit, card on file required)
# TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# TYPESAFE_API_KEY=<your AI Gateway key>
# TYPESAFE_MODEL=typesafe-ai/jev

# Local UI work without any key: a crude word-overlap mock, clearly labelled as not Jev.
# JEV_ENGINE=mock

# Live checks allowed per visitor IP per 10 minutes (best effort on serverless).
# RATE_LIMIT_PER_10_MIN=8
