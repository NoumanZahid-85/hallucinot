{
  "support-bot": {
    "question": "I bought the annual Pro plan 5 weeks ago and barely used it. Can I get a refund, and what happens to my notes?",
    "sentences": [
      {
        "i": 0,
        "text": "Thanks for reaching out, and sorry the Pro plan wasn't a fit!",
        "claim": 2.9198443276169457e-7
      },
      {
        "i": 1,
        "text": "Annual Pro plans can be refunded within 60 days of purchase, so at five weeks you're still eligible for a full refund.",
        "claim": 0.9999981145113043
      },
      {
        "i": 2,
        "text": "Refunds go back to your original payment method and usually show up within 5–10 business days.",
        "claim": 0.9999967425760585
      },
      {
        "i": 3,
        "text": "If you cancel, your account will switch to the Free plan and all of your existing notes will be kept.",
        "claim": 0.9999862820615913
      },
      {
        "i": 4,
        "text": "The Free plan includes unlimited synced devices.",
        "claim": 0.999992731377475
      },
      {
        "i": 5,
        "text": "You can also export all of your notes as Markdown or PDF from Settings → Data → Export.",
        "claim": 0.9999994135003059
      },
      {
        "i": 6,
        "text": "As a thank-you for being a Pro member, we'll add a free month of Pro to your account after the refund is processed.",
        "claim": 0.9985553197253185
      },
      {
        "i": 7,
        "text": "Your notes in Trash will be included in the export as well.",
        "claim": 0.9999996437712412
      },
      {
        "i": 8,
        "text": "Let me know if there's anything else I can help with!",
        "claim": 0.000006110875109430139
      }
    ],
    "passages": [
      {
        "i": 0,
        "doc": "Refund policy",
        "text": "Lumen Notes offers a full refund on annual Pro and Team plans if you request it within 30 days of the original purchase date. After 30 days, annual plans are non-refundable, but you can turn off auto-renewal at any time so you are not charged again."
      },
      {
        "i": 1,
        "doc": "Refund policy",
        "text": "Monthly plans are not eligible for refunds. When you cancel a monthly plan, you keep Pro features until the end of the current billing period."
      },
      {
        "i": 2,
        "doc": "Refund policy",
        "text": "Approved refunds are returned to the original payment method. Banks usually take 5–10 business days to show the refund on your statement."
      },
      {
        "i": 3,
        "doc": "Changing or cancelling your plan",
        "text": "When a Pro subscription ends, your account moves to the Free plan. Free accounts keep all existing notes, but are limited to 2 synced devices and 1 GB of attachment storage."
      },
      {
        "i": 4,
        "doc": "Changing or cancelling your plan",
        "text": "You can cancel from Settings → Billing → Manage plan. Cancelling stops future renewals; it does not delete your account or your notes."
      },
      {
        "i": 5,
        "doc": "Exporting your data",
        "text": "You can export every note at any time, on any plan, from Settings → Data → Export. Exports are available as Markdown files or as a single PDF archive."
      },
      {
        "i": 6,
        "doc": "Exporting your data",
        "text": "Deleted notes stay in Trash for 30 days before they are permanently removed. Notes in Trash cannot be exported."
      }
    ],
