  "hr-policy": {
    "question": "I'm expecting a baby in March. How much parental leave do I get, and can I work remotely afterwards?",
    "sentences": [
      {
        "i": 0,
        "text": "Congratulations on the upcoming arrival!",
        "claim": 0.0000013860981097978612
      },
      {
        "i": 1,
        "text": "Once you've completed 6 months of service, you're entitled to 16 weeks of parental leave at full pay.",
        "claim": 0.9999986320971613
      },
      {
        "i": 2,
        "text": "You can split the leave into as many blocks as you like, as long as you use it within 12 months.",
        "claim": 0.9999944648439016
      },
      {
        "i": 3,
        "text": "Please let your manager and People Operations know at least 8 weeks before your leave starts.",
        "claim": 0.6642652795316145
      },
      {
        "i": 4,
        "text": "New parents also get an extra week of paid \"nesting leave\" before the due date.",
        "claim": 0.9999935566752494
      },
      {
        "i": 5,
        "text": "When you come back, you can work 60% of your normal hours at full pay for your first 4 weeks.",
        "claim": 0.9999989675204745
      },
      {
        "i": 6,
        "text": "Kestrel also covers 100% of daycare costs for children under 5.",
        "claim": 0.9999994435020284
      },
      {
        "i": 7,
        "text": "After your leave, you can work remotely up to 3 days a week with your manager's approval.",
        "claim": 0.9999962060551171
      },
      {
        "i": 8,
        "text": "Fully remote work is automatically approved for new parents for their first year back.",
        "claim": 0.9999994143539854
      },
      {
        "i": 9,
        "text": "Remote employees need to be online during core hours, 10:00 to 15:00.",
        "claim": 0.9999989945524285
      }
    ],
    "passages": [
      {
        "i": 0,
        "doc": "Employee handbook — Parental leave",
        "text": "All employees who have completed 6 months of continuous service are eligible for parental leave. Eligible employees receive 16 weeks of leave at full pay, regardless of gender or how they became a parent."
      },
      {
        "i": 1,
        "doc": "Employee handbook — Parental leave",
        "text": "Parental leave must be taken within 12 months of the birth or adoption. It can be taken in one continuous block or split into up to two blocks of at least 4 weeks each."
      },
      {
        "i": 2,
        "doc": "Employee handbook — Parental leave",
        "text": "Employees should notify their manager and People Operations at least 8 weeks before the planned start of leave."
      },
      {
        "i": 3,
        "doc": "Employee handbook — Returning to work",
        "text": "For the first 4 weeks after returning from parental leave, employees may work a reduced schedule of 60% of their normal hours at full pay."
      },
      {
        "i": 4,
        "doc": "Employee handbook — Returning to work",
        "text": "Kestrel offers a monthly childcare stipend of 300 US dollars to employees with children under 5, paid through payroll."
      },
      {
        "i": 5,
        "doc": "Employee handbook — Remote work",
        "text": "Employees may work remotely up to 3 days per week with manager approval. Fully remote arrangements require approval from the department head and People Operations, and are reviewed every 6 months."
      },
      {
        "i": 6,
        "doc": "Employee handbook — Remote work",
        "text": "Employees working remotely must be available during core hours of 10:00 to 15:00 local office time."
      }
    ],
